# Example: trusted LAN proxy for a single MultiTech gateway
#
# Replace:
# - gw-089.example.com with the hostname users will enter in the app
# - https://onboarding.example.com with your Vercel/custom frontend URL
# - 192.168.0.89 with the actual gateway IP
# - certificate paths with your real certificate and key

server {
    listen 443 ssl http2;
    server_name gw-089.example.com;

    ssl_certificate     /etc/nginx/certs/gw-089.crt;
    ssl_certificate_key /etc/nginx/certs/gw-089.key;

    if ($request_method = OPTIONS) {
        add_header Access-Control-Allow-Origin "https://onboarding.example.com" always;
        add_header Access-Control-Allow-Methods "GET,POST,PUT,DELETE,OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type" always;
        add_header Access-Control-Max-Age 86400 always;
        add_header Content-Length 0;
        add_header Content-Type text/plain;
        return 204;
    }

    location / {
        proxy_pass https://192.168.0.89;
        proxy_ssl_verify off;
        proxy_set_header Host 192.168.0.89;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        add_header Access-Control-Allow-Origin "https://onboarding.example.com" always;
        add_header Access-Control-Allow-Methods "GET,POST,PUT,DELETE,OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type" always;
    }
}
