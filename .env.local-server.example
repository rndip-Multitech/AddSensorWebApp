# Copy this file to .env.local-server and edit the values for your machine/site.

# Bind to localhost only, or use 0.0.0.0 for phones/tablets on the same Wi-Fi.
HOST=0.0.0.0
PORT=3000

# Shared secret the browser app must send before the proxy forwards requests.
PROXY_ACCESS_KEY=change-this-secret

# Restrict which real gateway addresses users are allowed to enter.
ALLOWED_GATEWAY_HOSTS=192.168.0.89

# Optional IPv4 CIDR allowlist for whole local subnets.
# Example: 192.168.0.0/24
ALLOWED_GATEWAY_CIDRS=

# Optional DNS suffix allowlist instead of exact hosts.
ALLOWED_GATEWAY_SUFFIXES=

# Keep private IP routing enabled for LAN gateways.
ALLOW_PRIVATE_IP_TARGETS=true

# Keep HTTP disabled unless you truly need non-HTTPS gateways.
ALLOW_HTTP_TARGETS=false

# Optional fixed target if you ever want to lock the app to one gateway.
DEFAULT_GATEWAY_TARGET=
